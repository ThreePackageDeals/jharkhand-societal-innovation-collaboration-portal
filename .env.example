# Gemini AI (required for AI analysis features)
GEMINI_API_KEY=your_gemini_api_key_here


# Database (PostgreSQL via Supabase)
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.[id]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.[id]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Server
NODE_ENV=development
PORT=3000

# Auth (change this to a secure random string in production)
JWT_SECRET=change-this-to-a-secure-random-string
AUTH_BYPASS=false

# Email delivery (OTP messages use the configured SMTP transport)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM_NAME=Jharkhand Innovation Portal

# Resend email delivery (preferred; leave SMTP unset when using Resend)
# Use a verified sender such as "Jharkhand Innovation Portal <noreply@yourdomain.com>".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Jharkhand Innovation Portal <onboarding@yourdomain.com>

# Twilio SMS OTP delivery
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15005550006

# Free testing alternative (Textbelt: one free SMS/day with the public key)
# Set SMS_PROVIDER=textbelt to use it instead of Twilio.
TEXTBELT_API_KEY=textbelt

# SheerID student verification. Configure the webhook in MySheerID to call
# https://your-domain.example/api/auth/verify-sheerid.
SHEERID_API_KEY=your-sheerid-api-token
SHEERID_PROJECT_ID=your-sheerid-program-id
SHEERID_WEBHOOK_SECRET=your-sheerid-webhook-secret

# Set true only when every registered university domain is trusted for instant
# student verification. All other students are sent through SheerID.
ENABLE_STUDENT_DOMAIN_FAST_TRACK=false

# Google OAuth (add GOOGLE_REDIRECT_URI exactly as shown to the Google Cloud
# OAuth client's authorized redirect URIs)
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
