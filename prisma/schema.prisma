// Jharkhand Societal Innovation Collaboration Portal
// Prisma Schema — PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────

enum Role {
  CITIZEN
  STUDENT
  FACULTY
  INDUSTRY_REP
  UNIVERSITY_ADMIN
  GOVERNMENT_ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REJECTED
}

enum OrgType {
  STARTUP
  MSME
  CSR
  RESEARCH_LAB
  CORPORATE
}

// ─── Models ──────────────────────────────────────────────────

model User {
  id                 String             @id // must equal Supabase auth.users.id
  email              String?            @unique
  phone              String?            @unique
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  googleSubject      String?            @unique
  fullName           String
  role               Role
  verificationStatus VerificationStatus @default(NOT_REQUIRED)
  district           String?            // citizens: for Jharkhand geo-targeting/dashboards
  avatarUrl          String?
  isActive           Boolean            @default(true)
  // OTP values are stored as keyed hashes; never persist a raw verification code.
  otp                String?
  otpExpires         DateTime?
  sheerIdVerificationId String?         @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  submittedProblems    Problem[]
  discussions          Discussion[]
  notifications        Notification[]  @relation("NotificationRecipient")
  auditLogs            AuditLog[]

  studentProfile       StudentProfile?
  facultyProfile       FacultyProfile?
  industryProfile      IndustryProfile?
  verificationRequests VerificationRequest[] @relation("RequestOwner")
  reviewedRequests     VerificationRequest[] @relation("Reviewer")

  @@index([role])
  @@index([email])
}

model OtpChallenge {
  identifier String   @id
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Problem {
  id                   String        @id @default(uuid())
  trackingCode         String        @unique
  title                String
  description          String
  embedding            Float[]       // Semantic vector for deduplication
  domain               String
  district             String
  blockOrPanchayat     String        @default("District Headquarter Zone")
  locationLat          Float?
  locationLng          Float?
  locationAddress      String?
  urgency              String        @default("High")
  affectedPopulation   Int           @default(0)
  status               String        @default("submitted")
  socialImpactMetric   String?
  viewsCount           Int           @default(0)
  upvotesCount         Int           @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  // Submitter info
  submittedById        String?
  submittedBy          User?         @relation(fields: [submittedById], references: [id])
  submitterName        String        @default("Concerned Citizen")
  submitterType        String        @default("citizen")
  submitterContact     String?
  submitterEmail       String?
  submitterOrg         String?

  // Assignment
  assignedHeiId        String?
  assignedHei          University?   @relation(fields: [assignedHeiId], references: [id])
  assignedHeiName      String?
  assignedDepartment   String?

  // Industry Partner
  partnerOrgId        String?
  partnerOrg          Organization?  @relation(fields: [partnerOrgId], references: [id])
  partnerOrgName       String?
  fundingAmount        Float?

  // Relations
  aiAnalysis           AIAnalysis?
  mediaAttachments     MediaAttachment[]
  discussions          Discussion[]
  proposals            SolutionProposal[]
  auditLogs            AuditLog[]

  @@index([domain])
  @@index([district])
  @@index([status])
  @@index([trackingCode])
  @@index([createdAt])
}

model AIAnalysis {
  id                    String      @id @default(uuid())
  problemId             String      @unique
  problem               Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  category              String
  subCategory           String
  priorityScore         Int         // 1–100
  urgencyLevel          String
  thematicTags          Json
  recommendedTech       Json
  nepRelevance          String?
  estimatedBudgetBand   String?
  socialImpactPotential String?
  createdAt             DateTime    @default(now())

  // Sub-relations
  matchedHeis           MatchedHEI[]
  duplicateMatches      DuplicateMatch[]
}

model MatchedHEI {
  id              String      @id @default(uuid())
  aiAnalysisId    String
  aiAnalysis      AIAnalysis  @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
  universityId    String
  universityName  String
  department      String
  matchScore      Int         // 0–100
  reason          String

  @@index([aiAnalysisId])
}

model DuplicateMatch {
  id              String      @id @default(uuid())
  aiAnalysisId    String
  aiAnalysis      AIAnalysis  @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
  problemId       String
  title           String
  similarity      Int         // 0–100
  district        String

  @@index([aiAnalysisId])
}

model University {
  id                     String          @id @default(uuid())
  name                   String
  shortName              String
  district               String
  type                   String
  establishedYear        Int
  specializationDomains  Json
  departments            Json
  incubationCenter       String?
  website                String?
  activeProjectsCount    Int             @default(0)
  studentResearchersCount Int            @default(0)
  rating                 Float           @default(0)
  logoUrl                String?
  domains                String[]        // Registered domains for auto-verification
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  // Relations
  students               StudentProfile[]
  faculty                FacultyProfile[]
  assignedProblems       Problem[]
  proposals              SolutionProposal[]

  @@index([district])
}

model Organization {
  id                 String   @id @default(uuid())
  name               String
  type               OrgType
  registrationNumber String?  // GSTIN / CIN
  website            String?
  isVerified         Boolean  @default(false)

  // Keep some of the old IndustryPartner fields for backward compatibility if needed,
  // but the prompt specified these core ones.
  focusDomains       Json?
  headquarters       String?
  csrBudgetCommitted Float?   @default(0)
  availableMentors   Int?     @default(0)
  activeCollaborations Int?   @default(0)
  description        String?
  pilotTestSites     Json?
  contactPerson      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members            IndustryProfile[]
  problems           Problem[]
  proposals          SolutionProposal[]

  @@index([type])
}

model StudentProfile {
  userId          String     @id
  user            User       @relation(fields: [userId], references: [id])
  universityId    String
  university      University @relation(fields: [universityId], references: [id])
  studentIdNumber String?
  department      String?
  verifiedById    String?
  verifiedAt      DateTime?
}

model FacultyProfile {
  userId       String     @id
  user         User       @relation(fields: [userId], references: [id])
  universityId String
  university   University @relation(fields: [universityId], references: [id])
  employeeId   String?
  designation  String?
  department   String?
  verifiedById String?
  verifiedAt   DateTime?
}

model IndustryProfile {
  userId         String       @id
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  designation    String?
  verifiedById   String?
  verifiedAt     DateTime?
}

model VerificationRequest {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation("RequestOwner", fields: [userId], references: [id])
  role          Role
  documentUrls  String[]           // Supabase Storage paths
  status        VerificationStatus @default(PENDING)
  reviewerNotes String?
  reviewedById  String?
  reviewer      User?             @relation("Reviewer", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime           @default(now())
}

model SolutionProposal {
  id                    String          @id @default(uuid())
  problemId             String
  problem               Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemTitle          String
  heiId                 String
  hei                   University      @relation(fields: [heiId], references: [id])
  heiName               String
  projectTitle          String
  abstract              String
  technologyMethodology String
  nepExperientialCredits Int            @default(6)
  ipPotential           String          @default("PATENTABLE_TECHNOLOGY")
  status                String          @default("draft")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Faculty mentor (embedded)
  mentorName            String?
  mentorDepartment      String?
  mentorEmail           String?

  // Student team (embedded)
  teamLeadName          String?
  teamLeadEmail         String?
  teamMembersCount      Int             @default(4)
  teamDepartments       Json

  // Budget breakdown
  budgetHardware        Float           @default(0)
  budgetPrototyping     Float           @default(0)
  budgetFieldTesting    Float           @default(0)
  budgetTravel          Float           @default(0)
  budgetContingency     Float           @default(0)
  budgetTotal           Float           @default(0)

  // Industry Partner
  partnerOrgId           String?
  partnerOrg             Organization? @relation(fields: [partnerOrgId], references: [id])
  partnerOrgName         String?

  // Relations
  milestones            ProjectMilestone[]

  @@index([problemId])
  @@index([heiId])
  @@index([status])
}

model ProjectMilestone {
  id                    String          @id @default(uuid())
  proposalId            String
  proposal              SolutionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  title                 String
  stage                 String
  durationWeeks         Int
  status                String          @default("pending")
  deliverable           String
  verificationEvidence  String?
  completedDate         DateTime?
  createdAt             DateTime        @default(now())

  @@index([proposalId])
}

model Discussion {
  id            String    @id @default(uuid())
  problemId     String
  problem       Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  senderId      String?
  sender        User?     @relation(fields: [senderId], references: [id])
  senderName    String
  senderRole    String
  message       String
  avatarColor   String?
  timestamp     DateTime  @default(now())

  @@index([problemId])
  @@index([timestamp])
}

model MediaAttachment {
  id          String    @id @default(uuid())
  problemId   String
  problem     Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)
  url         String
  type        String    @default("image") // image, video, document
  filename    String?
  sizeBytes   Int?
  createdAt   DateTime  @default(now())

  @@index([problemId])
}

model Notification {
  id          String            @id @default(uuid())
  type        String            @default("info")
  title       String
  message     String
  targetRole  String            @default("All")
  read        Boolean           @default(false)
  actionUrl   String?
  recipientId String?
  recipient   User?             @relation("NotificationRecipient", fields: [recipientId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([recipientId])
  @@index([targetRole])
  @@index([read])
}

model AuditLog {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  problemId   String?
  problem     Problem?  @relation(fields: [problemId], references: [id])
  action      String    // e.g., "PROBLEM_CREATED", "HEI_ASSIGNED", "STATUS_UPDATED"
  details     String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([problemId])
  @@index([action])
  @@index([createdAt])
}
